# Vzor produkčního .env pro splatno.adamfujak.cz. Tajné hodnoty se doplňují jen na serveru, nikdy sem.
# Postup: docs/DEPLOY.md

APP_NAME="Splatno"
APP_ENV=production
# base64:… (postup v docs/DEPLOY.md). Po prvním nasazení už neměnit, zneplatní se sessions a šifrovaná data.
APP_KEY=
APP_DEBUG=false
APP_URL=https://splatno.adamfujak.cz

APP_LOCALE=cs
APP_FALLBACK_LOCALE=cs
APP_FAKER_LOCALE=cs_CZ

# Soubor storage/framework/down, který nahrává pipeline.
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# MySQL z hostingu.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Soubory, ne databáze: cache musí fungovat i před první migrací (nasazení se spouští přes cron).
CACHE_STORE=file

# SMTP Gigaserveru, schránka na adamfujak.cz.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# Tokeny provozních adres. Každý vygeneruj zvlášť, nejméně 40 znaků (doporučeno 64 hex znaků).
# HEALTH_TOKEN: hlavička X-Health-Token pro /_health (stejná hodnota jako GitHub secret HEALTH_TOKEN).
HEALTH_TOKEN=
# CRON_TOKEN: jen pokud hosting umí cron pouze přes URL (/_cron/{token}). Jinak nech prázdné.
CRON_TOKEN=
# SETUP_TOKEN: jen pro založení prvního uživatele (/setup?token=…). Po použití SMAZAT.
SETUP_TOKEN=

VITE_APP_NAME="${APP_NAME}"
