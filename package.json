{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc --noEmit && vite build",
        "lint": "eslint . && prettier --check resources/js vite.config.ts eslint.config.js && tsc --noEmit",
        "format": "prettier --write resources/js vite.config.ts eslint.config.js"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@inertiajs/react": "^3.9.1",
        "@tailwindcss/vite": "^4.0.0",
        "@types/node": "^26.6.5",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^5.2.0",
        "concurrently": "^9.0.1",
        "eslint": "^10.13.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^17.13.0",
        "laravel-vite-plugin": "^2.0.0",
        "lucide-react": "^1.61.0",
        "prettier": "^3.9.10",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "tailwindcss": "^4.0.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.0",
        "vite": "^7.0.7"
    }
}
